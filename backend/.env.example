# Conexão com o Postgres (Supabase)
DATABASE_URL="postgresql://usuario:senha@host:5432/postgres"

# Credenciais do admin único do sistema.
ADMIN_EMAIL="admin@exemplo.com"

# A senha do admin é comparada por bcrypt. Gere o hash com:
#   npm run hash-password -- "sua-senha"
ADMIN_PASSWORD_HASH="$2b$12$..."

# Alternativa de transição: sem ADMIN_PASSWORD_HASH, o servidor gera o hash de
# ADMIN_PASSWORD na subida e avisa no log. Funciona, mas mantém a senha em
# texto puro no ambiente — prefira o hash acima.
ADMIN_PASSWORD="troque-esta-senha"

# Segredo de assinatura do JWT. O token carrega o papel (admin ou customer),
# então vazar este segredo agora permite forjar acesso de administração.
JWT_SECRET="troque-este-segredo"
# O token de sessão carrega um marcador para poder ser revogado. Trocar a senha do
# admin (ADMIN_PASSWORD_HASH ou ADMIN_PASSWORD) ou o ADMIN_EMAIL derruba as sessões
# de admin abertas — o admin entra de novo. Trocar o JWT_SECRET derruba todas.

# Origens autorizadas a chamar a API, separadas por vírgula.
# Sem esta variável a API aceita qualquer origem — defina em produção.
CORS_ORIGINS="https://seu-frontend.vercel.app"

# Quantos proxies existem na frente da aplicação. Em serviços gerenciados
# (Render, Railway, Fly) é 1 — sem isso o rate limit enxerga o IP do proxy no
# lugar do IP de quem chamou, e todo mundo divide o mesmo balde de tentativas.
# Nunca use "true": aí o X-Forwarded-For passa a ser confiável e forjável.
# O padrão já é 1 em produção e 0 fora dela; só declare se for diferente disso.
TRUST_PROXY="1"

# Em "production" o log de query do Prisma é desligado, o servidor exige um
# JWT_SECRET de pelo menos 32 caracteres e avisa sobre CORS_ORIGINS ausente.
NODE_ENV="development"

# --- Aviso de pedido novo (opcional) ---
# Os dois canais avisam VOCÊ, não o cliente, e são independentes: um fora do ar
# não impede o outro, e falha de aviso nunca derruba o pedido. Sem as variáveis,
# o canal correspondente é simplesmente pulado.

# Telegram: crie um bot no @BotFather e pegue o seu chat_id.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# E-mail, via Resend. O remetente precisa ser de um domínio verificado.
RESEND_API_KEY=""
ORDER_NOTIFICATION_FROM="pedidos@seudominio.com"
ORDER_NOTIFICATION_EMAIL="voce@exemplo.com"

# --- Fotos dos produtos (Supabase Storage) ---
# O upload é assinado pelo servidor: o navegador não escreve mais no bucket com
# a chave anon. A service role NUNCA vai para o frontend nem para o git.
# Depois de configurar, remova do bucket `produtos` a policy de INSERT para
# `anon`/`public`, e limite tipo (jpeg/png/webp) e tamanho (5 MB) no próprio bucket.
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
