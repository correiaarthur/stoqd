# Endereço da API. É lido no BUILD, não em tempo de execução: na Vercel isto
# precisa estar nas variáveis de ambiente do projeto ANTES do deploy, senão o
# site publicado sai chamando o localhost de quem gerou o build.
# Em desenvolvimento pode ficar em branco — o padrão é http://localhost:3001.
VITE_API_URL="https://sua-api.onrender.com"

# Supabase Storage, usado para as fotos dos produtos.
# A chave anon é pública por natureza: ela vai dentro do bundle JavaScript e
# qualquer pessoa consegue lê-la. Quem protege o bucket é a policy do Supabase,
# nunca o segredo da chave.
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-chave-anon"
